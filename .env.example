# Neon Postgres Database (via Vercel / Neon integration)
POSTGRES_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Neon Managed Better Auth (@neondatabase/auth)
NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-1.aws.neon.tech/neondb/Auth
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-character-secret-string

# Cloudflare R2 Object Storage for Payload CMS Media (@payloadcms/storage-s3)
R2_BUCKET=the-store-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# ImageKit Optimization (@imagekit/next)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ComposeIt API Configuration (POSTs { templateId, formats: ["pdf"] | ["html"], data } with header `x-api-key`)
COMPOSEIT_API_URL=
COMPOSEIT_API_KEY=

INVOICE_PDF_TEMPLATE_ID=tpl_invoice_pdf_v1
RECEIPT_PDF_TEMPLATE_ID=tpl_receipt_pdf_v1
RECEIPT_EMAIL_TEMPLATE_ID=tpl_order_receipt_email_v1

# Outbound SMTP Configuration for Nodemailer (attaches PDFs via `path: pdf.url`)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Storefront Orders <orders@storefront.example.com>"
