# Neon Postgres Database (via Vercel / Neon integration)
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require
DB_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Neon Managed Better Auth (@neondatabase/auth)
NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-1.aws.neon.tech/neondb/Auth

# Cloudflare R2 Object Storage for Payload CMS Media (@payloadcms/storage-s3)
R2_BUCKET=the-store-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# ImageKit Optimization (@imagekit/next)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ComposeIt API Configuration (POSTs { templateId, formats: ["pdf"] | ["html"], data } with header `x-api-key`)
COMPOSEIT_API_URL=
COMPOSEIT_API_KEY=

INVOICE_PDF_TEMPLATE_ID=tpl_invoice_pdf_v1
RECEIPT_PDF_TEMPLATE_ID=tpl_receipt_pdf_v1
RECEIPT_EMAIL_TEMPLATE_ID=tpl_order_receipt_email_v1

# Outbound Email Configuration for Resend (attaches PDFs via `path: pdf.url`)
RESEND_API_KEY=
RESEND_FROM="Storefront Orders <onboarding@resend.dev>"

# Shared secret for server-to-server payment confirmation callbacks (`x-payment-webhook-secret`)
PAYMENT_WEBHOOK_SECRET=

# Paynow Express Mobile Payments (EcoCash & OneMoney)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# Optional ZIMRA FDMS Fiscalization (adds fiscal QR code to receipts when configured)
ZIMRA_FDMS_ENVIRONMENT=test
ZIMRA_FDMS_DEVICE_ID=
ZIMRA_FDMS_SERIAL_NUMBER=
ZIMRA_FDMS_MODEL_NAME=Server
ZIMRA_FDMS_MODEL_VERSION=v1
ZIMRA_FDMS_CERTIFICATE_PEM=
ZIMRA_FDMS_PRIVATE_KEY_PEM=
ZIMRA_FDMS_CURRENCY=USD
# Optional explicit tax mapping (defaults to matching tax from FDMS getConfig)
# ZIMRA_FDMS_TAX_ID=513
# ZIMRA_FDMS_TAX_PERCENT=0
